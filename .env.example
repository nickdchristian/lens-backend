# Database Configuration
# Supported types: dynamodb, mongodb
DATABASE_TYPE=dynamodb

# --- DynamoDB Settings ---
DYNAMO_TABLE_NAME=LensEvents
AWS_REGION=us-east-1

# --- MongoDB Settings ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=lens

# Rate Limiting
RATE_LIMIT_EVENTS=100/minute
RATE_LIMIT_API=50/minute

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dashboard OAuth2 Configuration (Optional)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
OAUTH_USERINFO_URL=https://api.github.com/user
SESSION_SECRET_KEY=generate_a_random_secret_string_here8000

# CI/CD Ingestion Federation (OIDC)
OIDC_ISSUER_URL=
OIDC_AUDIENCE=lens-telemetry

# Authentication
# Global API Key used by CI/CD pipelines to ingest events.
# If omitted, the ingestion endpoint will reject all requests.
# Generate a key using: openssl rand -hex 32
API_KEY=your_super_secret_generated_key_here
